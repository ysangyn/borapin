rules_version = '2';

// 보라핀 보안 규칙
// - 우리 공간(main): 허용 목록(config/access.allowed)에 있고, 구성원 문서(spaces/main/members/{uid})도 있는 계정만 읽고 쓸 수 있다.
// - 그 밖의 공간: 그 공간에 구성원 문서(spaces/{공간}/members/{uid})가 있는 계정만.
// - 주인 계정(OWNER)은 허용 목록이 비어 있어도 들어와 처음 설정을 만들 수 있다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && email() == 'ysangyn@gmail.com'; }
    function accessDoc() { return get(/databases/$(database)/documents/config/access); }
    function isMember() {
      return isOwner()
        || (signedIn()
            && exists(/databases/$(database)/documents/config/access)
            && email() in accessDoc().data.allowed);
    }
    function isAdmin() {
      return isOwner() || (isMember() && email() in accessDoc().data.admins);
    }

    // 멤버가 앱에서 쓸 자기 이름만 바꾼다: names.<내 메일> 한 칸만, 1~10자
    function renamingSelf() {
      let me = request.auth.token.email.lower();
      return isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names', 'updatedAt'])
        && request.resource.data.names is map
        && request.resource.data.names.diff(resource.data.get('names', {})).affectedKeys().hasOnly([me])
        && me in request.resource.data.names
        && request.resource.data.names[me] is string
        && request.resource.data.names[me].size() >= 1 && request.resource.data.names[me].size() <= 10
        && validAccess(request.resource.data);
    }

    function validAccess(d) {
      return d.keys().hasOnly(['allowed', 'admins', 'names', 'relations', 'updatedAt', 'via'])
        && (!('names' in d) || (d.names is map && d.names.size() <= 50))
        && (!('relations' in d) || (d.relations is map && d.relations.size() <= 50))
        && d.allowed is list && d.allowed.size() <= 50
        && d.admins is list && d.admins.size() <= 10;
    }

    function validTrip(d) {
      return d.keys().hasAll(['title', 'kind', 'status', 'when', 'places', 'v'])
        && d.title is string && d.title.size() <= 100
        && d.kind in ['trip', 'outing']
        && d.status in ['done', 'planned']
        && d.when is map
        && d.places is list && d.places.size() >= 1 && d.places.size() <= 50
        && (!('companions' in d) || (d.companions is list && d.companions.size() <= 30))
        && (!('memo' in d) || (d.memo is string && d.memo.size() <= 10000))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 30))
        && (!('packing' in d) || (d.packing is list && d.packing.size() <= 200))
        && (!('stay' in d) || d.stay == null || (d.stay is map && d.stay.name is string && d.stay.name.size() <= 80))
        && (!('hopes' in d) || (d.hopes is map && d.hopes.size() <= 10))
        && optList(d, 'planDone', 10)
        && (!('way' in d) || (d.way is map && d.way.keys().hasOnly(['go', 'back'])))
        && optList(d, 'bookings', 30)
        && d.v == 1;
    }

    function optList(d, k, n) { return !(k in d) || (d[k] is list && d[k].size() <= n); }

    function validPlaceMap(d) {
      return d.keys().hasAll(['region', 'theme', 'v'])
        && d.region is map && d.theme is string && d.theme.size() <= 24
        && (!('title' in d) || (d.title is string && d.title.size() <= 60))
        && (!('intro' in d) || (d.intro is string && d.intro.size() <= 200))
        && optList(d, 'order', 300)
        && (!('share' in d) || d.share == null || (d.share is map && d.share.token is string))
        && d.v == 1;
    }

    function validWish(d) {
      return d.keys().hasAll(['place', 'v'])
        && d.place is map
        && (!('note' in d) || (d.note is string && d.note.size() <= 5000))
        && (!('spotName' in d) || (d.spotName is string && d.spotName.size() <= 60))
        && optList(d, 'wantedBy', 10) && optList(d, 'links', 20) && optList(d, 'months', 12)
        && optList(d, 'spots', 50) && optList(d, 'todos', 50) && optList(d, 'foods', 50) && optList(d, 'gone', 100)
        && (!('priority' in d) || d.priority == null || d.priority in [1, 2, 3])
        && d.v == 1;
    }

    function validPlace(d) {
      return d.keys().hasAll(['name', 'kind', 'region', 'v'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.kind in ['food', 'cafe', 'sight', 'stay', 'shop', 'etc']
        // 내가 만든 꼬리표 (소품샵·옷가게·빵집…): 종류 안의 작은 주제
        && (!('tag' in d) || (d.tag is string && d.tag.size() <= 20))
        && (!('status' in d) || d.status in ['want', 'been'])
        && d.region is map
        && (!('reviews' in d) || (d.reviews is map && d.reviews.size() <= 10))
        && (!('verdict' in d) || d.verdict == null || d.verdict in ['again', 'once', 'meh'])
        && (!('naverUrl' in d) || (d.naverUrl is string && d.naverUrl.size() <= 500))
        // 같은 가게를 알아보는 번호 (카카오 가게 번호 · 네이버 장소 번호)
        && (!('ref' in d) || d.ref == null || (d.ref is map && d.ref.keys().hasOnly(['src', 'id'])
              && d.ref.src in ['kakao', 'naver'] && d.ref.id is string && d.ref.id.size() >= 1 && d.ref.id.size() <= 40))
        // 한 줄 평을 쓴 사람의 uid (이름 → uid). 공개 평을 나눌 때 '내 평'을 가려낸다
        && (!('reviewBy' in d) || (d.reviewBy is map && d.reviewBy.size() <= 10))
        && (!('memo' in d) || (d.memo is string && d.memo.size() <= 5000))
        && (!('photoUrl' in d) || (d.photoUrl is string && d.photoUrl.size() <= 600 && d.photoUrl.matches('https://.*')))
        && (!('lat' in d) || (d.lat is number && d.lat >= -90 && d.lat <= 90))
        && (!('lng' in d) || (d.lng is number && d.lng >= -180 && d.lng <= 180))
        && d.v == 1;
    }

    // 링크 공유 사본은 어느 공간 것인지 spaceId로 안다 (없는 옛 사본은 우리 공간 'main').
    // 공간이 여럿이 되어도 자기 공간 것만 만들고 고치고 지운다. 읽기는 토큰을 아는 누구나.
    function shareSpaceOf(d) { return d.get('spaceId', 'main'); }
    function shareSpaceOk() { return shareSpaceOf(request.resource.data) is string && inSpace(shareSpaceOf(request.resource.data)); }
    function ownShare() { return inSpace(shareSpaceOf(resource.data)); }
    function sameShareSpace() { return shareSpaceOf(request.resource.data) == shareSpaceOf(resource.data); }
    function validTripShare(d) {
      return d.keys().hasAll(['title', 'when', 'places', 'photos', 'v'])
        && d.title is string && d.title.size() <= 100
        && d.photos is list && d.photos.size() <= 60
        && !('memo' in d) && !('companions' in d);
    }
    function validMapShare(d) {
      return d.keys().hasAll(['title', 'theme', 'by', 'places', 'v'])
        && d.title is string && d.title.size() <= 60
        && d.places is list && d.places.size() <= 300
        && !('memo' in d);
    }

    function validPhoto(d) {
      return d.keys().hasAll(['w', 'h', 'bytes', 'v'])
        && d.w is int && d.h is int
        && d.bytes is int && d.bytes < 2 * 1024 * 1024
        && (!('caption' in d) || (d.caption is string && d.caption.size() <= 500))
        && d.v == 1;
    }

    function validPlan(d) {
      return d.keys().hasAll(['tripId', 'name', 'v'])
        && d.tripId is string && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && (!('info' in d) || (d.info is string && d.info.size() <= 200))
        && optList(d, 'by', 10)
        && (!('img' in d) || (d.img is string && d.img.size() <= 500))
        && d.v == 1;
    }
    function validNote(d) {
      return d.keys().hasAll(['tripId', 'text', 'by', 'v'])
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 5000
        && d.by.uid == request.auth.uid
        // 타임캡슐: 열리는 날 'YYYY-MM-DD' (선택)
        && (!('openAt' in d) || (d.openAt is string && d.openAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        // 며칠째 이야기 (선택)
        && (!('day' in d) || d.day == null || (d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && d.v == 1;
    }

    // 초대 링크: 관리자가 만든 코드(문서 이름)로 들어온 사람이 자기 메일을 허용 목록에 넣는다 (서버 없이)
    function inviteOf(code) { return get(/databases/$(database)/documents/invites/$(code)); }
    function joiningByInvite() {
      let d = request.resource.data;
      let old = resource.data;
      return signedIn() && !isMember()
        && d.keys().hasOnly(['allowed', 'admins', 'names', 'relations', 'updatedAt', 'via'])
        && d.via is string && d.via.size() >= 8 && d.via.size() <= 64
        && exists(/databases/$(database)/documents/invites/$(d.via))
        && inviteOf(d.via).data.usedBy == email()
        // 바뀌는 건 내 메일 한 줄(과 내 이름)뿐
        && d.admins == old.admins
        && d.allowed.hasAll(old.allowed) && d.allowed.size() == old.allowed.size() + 1 && d.allowed.size() <= 50
        && email() in d.allowed
        && d.get('names', {}).diff(old.get('names', {})).affectedKeys().hasOnly([email()])
        && d.get('relations', {}).diff(old.get('relations', {})).affectedKeys().hasOnly([email()]);
    }

    match /config/access {
      allow read: if isMember();
      allow create: if isOwner() && validAccess(request.resource.data);
      allow update: if (isAdmin() && validAccess(request.resource.data)
        // 주인 계정은 허용·관리자 목록에서 빠지지 않게
        && 'ysangyn@gmail.com' in request.resource.data.allowed
        && 'ysangyn@gmail.com' in request.resource.data.admins)
        || joiningByInvite()
        || renamingSelf();
      allow delete: if false;
    }

    // 초대: 문서 이름이 코드. 관리자가 만들고(7일), 링크로 온 사람이 자기 메일로 '썼음' 표시를 한 번만 한다
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['by', 'name', 'relation', 'createdAt', 'expiresAt', 'v'])
        && request.resource.data.by == email()
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 20))
        && (!('relation' in request.resource.data) || request.resource.data.relation in ['spouse', 'partner', 'family', 'friend', 'relative', 'other'])
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt <= request.time.toMillis() + 8 * 24 * 3600 * 1000
        && request.resource.data.v == 1;
      allow update: if signedIn()
        && !('usedBy' in resource.data)
        && request.time.toMillis() < resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == email();
      allow delete: if isAdmin();
    }

    // 앱 스위치(사진 올리기 멈춤 등): 멤버는 읽고 관리자만 바꾼다
    match /config/flags {
      allow read: if isMember() || isUser();
      allow write: if isAdmin();
    }
    // 오류 기록·문제 신고: 멤버가 남기고 관리자가 보고 지운다
    match /reports/{id} {
      allow create: if (isMember() || isUser())
        && request.resource.data.kind in ['error', 'report']
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && (!('detail' in request.resource.data) || (request.resource.data.detail is string && request.resource.data.detail.size() <= 3000));
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // 링크 공개된 여행 사본: 토큰을 아는 사람만 하나씩 읽을 수 있다 (목록 조회 불가)
    match /shares/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if shareSpaceOk()
        && validTripShare(request.resource.data);
      allow update: if shareSpaceOk() && ownShare() && sameShareSpace()
        && validTripShare(request.resource.data);
      allow delete: if ownShare();
    }

    // 링크 공개된 내 지도 사본: 토큰을 아는 사람은 누구나 하나씩 읽는다 (목록 조회 불가). 메모·함께 간 사람은 넣지 않는다
    match /mapShares/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if shareSpaceOk()
        && validMapShare(request.resource.data);
      allow update: if shareSpaceOk() && ownShare() && sameShareSpace()
        && validMapShare(request.resource.data);
      allow delete: if ownShare();
    }

    // 공간의 문 (docs/design/SPACES-PUBLIC.md 3절): 어느 공간이든 그 공간에 내 구성원 문서가 있어야 들어온다. 마을 주인도 예외가 아니다.
    // - 우리 공간(main)은 여기에 더해 옛 메일 목록(config/access)에도 있어야 한다.
    //   목록은 '자기 구성원 문서를 만들 자격'이다: 목록에 있는 사람은 앱을 열 때 자기 문서를 스스로 만들고 들어온다.
    //   그리고 안전장치다: 목록에서 빼면 문서가 남아 있어도 바로 못 들어오고, 문서를 다시 만들지도 못한다.
    function memberPath(spaceId) { return /databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid); }
    function inSpace(spaceId) {
      return (spaceId == 'main' && isMember() && exists(memberPath(spaceId)))
        || (spaceId != 'main' && signedIn() && exists(memberPath(spaceId)));
    }

    // 이 요청(묶음)이 끝난 뒤의 모습으로 보는 문: 들어오는 묶음 안에서 별명 문서를 함께 만들 때 쓴다
    function inSpaceAfter(spaceId) {
      return (spaceId == 'main' && isMember() && existsAfter(memberPath(spaceId)))
        || (spaceId != 'main' && signedIn() && existsAfter(memberPath(spaceId)));
    }
    function spaceAdmin(spaceId) {
      return (spaceId == 'main' && isAdmin())
        || (spaceId != 'main' && signedIn() && exists(memberPath(spaceId)) && get(memberPath(spaceId)).data.role == 'admin');
    }
    // 보라핀 사람: 별명 문서가 가리키는 공간에 지금도 구성원 문서가 있는 사람 (내보내지면 바로 아니게 된다)
    function profilePath() { return /databases/$(database)/documents/profiles/$(request.auth.uid); }
    function isUser() {
      return signedIn() && exists(profilePath()) && inSpace(get(profilePath()).data.spaceId);
    }

    // ---- 공간 초대장 (spaceInvites/{코드}): 어느 공간에 어떤 역할로 들어오는지 적혀 있다 ----
    // 우리 공간(main)의 초대는 옛 문을 닫을 때까지 예전 그대로 invites/{코드}를 쓴다. 두 모음은 서로 섞이지 않는다.
    function spaceInvitePath(code) { return /databases/$(database)/documents/spaceInvites/$(code); }
    function spaceDocPath(spaceId) { return /databases/$(database)/documents/spaces/$(spaceId); }
    function validMemberBasics(d) {
      return d.keys().hasOnly(['uid', 'email', 'role', 'name', 'relation', 'via', 'joinedAt', 'updatedAt', 'v'])
        && d.keys().hasAll(['uid', 'email', 'role', 'name', 'via', 'v'])
        && d.uid == request.auth.uid
        && d.email == email()
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && (!('relation' in d) || d.relation in ['spouse', 'partner', 'family', 'friend', 'relative', 'other'])
        && d.v == 1;
    }
    // 초대장으로 들어오는 사람의 구성원 문서. 같은 묶음에서 초대장에 '썼음' 표시를 해야 한다:
    // - 묶음 전에는 안 쓴 초대장이고, 묶음 뒤에는 내 메일로 표시돼 있다 → 한 번만, 기한 안에만 (표시 규칙이 기한을 본다)
    // - 공간과 역할은 초대장에 적힌 그대로
    // - 구성원 자리: 이미 있는 공간에만. 관리자 자리: 아직 없는 공간에, 같은 묶음에서 공간 문서를 만들 때만 (첫 관리자는 한 사람)
    function validInvitedMember(spaceId, d) {
      return validMemberBasics(d)
        && d.role in ['admin', 'member']
        && d.via is string && d.via.size() >= 8 && d.via.size() <= 64
        && exists(spaceInvitePath(d.via))
        && !('usedBy' in get(spaceInvitePath(d.via)).data)
        && getAfter(spaceInvitePath(d.via)).data.usedBy == email()
        && get(spaceInvitePath(d.via)).data.spaceId == spaceId
        && get(spaceInvitePath(d.via)).data.role == d.role
        && ((d.role == 'member' && exists(spaceDocPath(spaceId)))
          || (d.role == 'admin' && !exists(spaceDocPath(spaceId)) && existsAfter(spaceDocPath(spaceId))));
    }
    function validSpaceInvite(d) {
      return d.keys().hasOnly(['by', 'spaceId', 'role', 'spaceName', 'name', 'relation', 'createdAt', 'expiresAt', 'v'])
        && d.keys().hasAll(['by', 'spaceId', 'role', 'expiresAt', 'v'])
        && d.by == email()
        && d.spaceId is string && d.spaceId.matches('^[A-Za-z0-9]{20}$')
        && (!('spaceName' in d) || (d.spaceName is string && d.spaceName.size() <= 60))
        && (!('name' in d) || (d.name is string && d.name.size() <= 20))
        && (!('relation' in d) || d.relation in ['spouse', 'partner', 'family', 'friend', 'relative', 'other'])
        && d.expiresAt is int
        && d.expiresAt <= request.time.toMillis() + 8 * 24 * 3600 * 1000
        && d.v == 1;
    }
    match /spaceInvites/{code} {
      allow get: if signedIn();
      // 목록은 만든 사람이 자기 것만 (남의 공간 초대장 코드를 엿보지 못하게)
      allow list: if signedIn() && resource.data.by == email();
      allow create: if signedIn() && validSpaceInvite(request.resource.data)
        && (
          // 있는 공간에 들이기: 그 공간 관리자가, 구성원 자리만
          (request.resource.data.role == 'member' && spaceAdmin(request.resource.data.spaceId))
          // 새 공간 열어 주기: 마을 주인만, 아직 없는 공간에, 첫 관리자 자리만
          || (request.resource.data.role == 'admin' && isOwner() && !exists(spaceDocPath(request.resource.data.spaceId)))
        );
      // 쓰기: 안 쓴 초대장에 내 메일로 한 번만, 기한 안에. 같은 묶음에서 그 공간에 내 구성원 문서가 생겨야 한다 (표시만 해서 못 쓰게 만들 수 없다)
      allow update: if signedIn()
        && !('usedBy' in resource.data)
        && request.time.toMillis() < resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == email()
        && !exists(memberPath(resource.data.spaceId))
        && existsAfter(memberPath(resource.data.spaceId));
      allow delete: if signedIn() && (resource.data.by == email() || spaceAdmin(resource.data.spaceId));
    }

    // 옛 목록에 있는 사람이 우리 공간에 만드는 자기 구성원 문서. 역할은 옛 관리자 목록을 그대로 따른다
    function validLegacyMember(d) {
      return validMemberBasics(d)
        && ((isAdmin() && d.role == 'admin') || (!isAdmin() && d.role == 'member'))
        && d.via == 'legacy';
    }

    // 별명 문서: 사람마다 하나. 별명과 '지금 쓰는 공간'만 (메일·실명·역할 칸은 없다). 자기 것만 읽고 쓴다
    match /profiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'spaceId', 'updatedAt', 'v'])
        && request.resource.data.keys().hasAll(['nick', 'spaceId', 'v'])
        && request.resource.data.nick is string
        && request.resource.data.nick.size() >= 1 && request.resource.data.nick.size() <= 10
        && request.resource.data.spaceId is string && request.resource.data.spaceId.size() <= 40
        && inSpaceAfter(request.resource.data.spaceId)
        && request.resource.data.v == 1;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ================= 모임 (docs/design/SPACES-PUBLIC.md 4절) =================
    // 공간은 전부 함께 쓰는 사이, 모임은 고른 가게의 사본만 보여 주는 사이.
    // - 모임 사람만 읽는다 (마을 주인도 들지 않은 모임은 못 본다). 모임에 든다고 서로의 공간이 보이지는 않는다.
    // - 만들기: 자기 공간이 있는 사람. 들어오기: 방장이 만든 초대장으로, 공간이 없는 사람도 손님으로.
    // - 구성원 문서·초대장에는 메일을 넣지 않는다 (uid와 별명만).
    function circlePath(cid) { return /databases/$(database)/documents/circles/$(cid); }
    function circleMemberPath(cid) { return /databases/$(database)/documents/circles/$(cid)/members/$(request.auth.uid); }
    function circleInvitePath(code) { return /databases/$(database)/documents/circleInvites/$(code); }
    function inCircle(cid) { return signedIn() && exists(circleMemberPath(cid)); }
    function circleHost(cid) { return signedIn() && exists(circleMemberPath(cid)) && get(circleMemberPath(cid)).data.role == 'host'; }
    // 사본에 적는 공간 이름: 없거나(손님), 내가 든 공간. 같은 공간 사람(짝)이 내려 줄 수 있게 하려는 칸이다
    function ownSpaceOrNone(d) { return d.spaceId == null || (d.spaceId is string && inSpace(d.spaceId)); }
    function validCircle(d) {
      return d.keys().hasOnly(['name', 'createdBy', 'createdAt', 'updatedAt', 'v'])
        && d.keys().hasAll(['name', 'createdBy', 'v'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.createdBy is string
        && d.v == 1;
    }
    function validCircleMember(d) {
      return d.keys().hasOnly(['uid', 'role', 'nick', 'via', 'joinedAt', 'updatedAt', 'v'])
        && d.keys().hasAll(['uid', 'role', 'nick', 'via', 'v'])
        && d.uid == request.auth.uid
        && d.role in ['host', 'member']
        && d.nick is string && d.nick.size() >= 1 && d.nick.size() <= 10
        && d.via is string
        && d.v == 1;
    }
    // 걸린 가게(사본). 문서 이름은 '열쇠_내 uid': 한 사람이 한 가게를 한 번만, 그리고 자기 것만
    function validCircleItem(d, itemId) {
      return d.keys().hasOnly(['key', 'name', 'kind', 'tag', 'lat', 'lng', 'region', 'verdict', 'line', 'photos', 'placeKey', 'by', 'spaceId', 'at', 'updatedAt', 'v'])
        && d.keys().hasAll(['key', 'name', 'kind', 'by', 'spaceId', 'v'])
        && d.key is string && d.key.matches('^[A-Za-z0-9]{1,60}$')
        && itemId == d.key + '_' + request.auth.uid
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.kind in ['food', 'cafe', 'sight', 'stay', 'shop', 'etc']
        && (!('tag' in d) || (d.tag is string && d.tag.size() <= 20))
        && (!('lat' in d) || (d.lat is number && d.lat >= -90 && d.lat <= 90))
        && (!('lng' in d) || (d.lng is number && d.lng >= -180 && d.lng <= 180))
        && (!('region' in d) || (d.region is map && d.region.size() <= 4))
        && (!('verdict' in d) || d.verdict == null || d.verdict in ['again', 'once', 'meh'])
        && (!('line' in d) || (d.line is string && d.line.size() <= 200))
        && (!('photos' in d) || (d.photos is list && d.photos.size() <= 4))
        && (!('placeKey' in d) || (d.placeKey is string && d.placeKey.size() <= 64))
        && d.by is map && d.by.keys().hasOnly(['uid', 'nick'])
        && d.by.uid == request.auth.uid
        && d.by.nick is string && d.by.nick.size() >= 1 && d.by.nick.size() <= 10
        && ownSpaceOrNone(d)
        && d.v == 1;
    }
    // 내릴 수 있는 사람: 본인, 방장, 같은 공간 사람(짝) — 모두 모임 안에 있어야 한다
    function canTakeDown(cid, by, spaceId) {
      return inCircle(cid)
        && (by == request.auth.uid || circleHost(cid) || (spaceId is string && inSpace(spaceId)));
    }

    match /circles/{cid} {
      allow get: if inCircle(cid);
      allow list: if false;
      // 만들기: 같은 묶음에서 내 방장 문서를 함께 만든다 (서로를 확인)
      allow create: if isUser()
        && cid.matches('^[A-Za-z0-9]{20}$')
        && validCircle(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && !exists(circleMemberPath(cid))
        && existsAfter(circleMemberPath(cid))
        && getAfter(circleMemberPath(cid)).data.role == 'host';
      allow update: if circleHost(cid) && validCircle(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if circleHost(cid);

      match /members/{uid} {
        allow read: if inCircle(cid);
        allow create: if signedIn() && request.auth.uid == uid && validCircleMember(request.resource.data)
          && (
            // 방장: 모임을 만드는 그 묶음에서만
            (request.resource.data.role == 'host' && request.resource.data.via == 'host'
              && !exists(circlePath(cid)) && existsAfter(circlePath(cid))
              && getAfter(circlePath(cid)).data.createdBy == request.auth.uid)
            // 구성원: 이 모임의 안 쓴 초대장에 같은 묶음에서 내 표시를 할 때만 (한 번만·기한 안은 초대장 규칙이 본다)
            || (request.resource.data.role == 'member'
              && request.resource.data.via.size() >= 8 && request.resource.data.via.size() <= 64
              && exists(circlePath(cid))
              && exists(circleInvitePath(request.resource.data.via))
              && !('usedBy' in get(circleInvitePath(request.resource.data.via)).data)
              && getAfter(circleInvitePath(request.resource.data.via)).data.usedBy == request.auth.uid
              && get(circleInvitePath(request.resource.data.via)).data.circleId == cid)
          );
        // 자기 별명만
        allow update: if inCircle(cid) && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nick', 'updatedAt'])
          && validCircleMember(request.resource.data);
        allow delete: if
          // 스스로 나가기 (방장은 모임을 없애는 묶음에서만)
          (inCircle(cid) && request.auth.uid == uid && (resource.data.role != 'host' || !existsAfter(circlePath(cid))))
          // 방장이 남을 내보내기
          || (circleHost(cid) && request.auth.uid != uid);
      }

      match /items/{itemId} {
        allow read: if inCircle(cid);
        allow create: if inCircle(cid) && validCircleItem(request.resource.data, itemId);
        allow update: if inCircle(cid) && resource.data.by.uid == request.auth.uid && validCircleItem(request.resource.data, itemId);
        allow delete: if canTakeDown(cid, resource.data.by.uid, resource.data.spaceId);
      }

      // 사진 사본 (작게 줄인 것). 위경도·찍은 시각 칸은 없다
      match /photos/{photoId} {
        allow read: if inCircle(cid);
        allow create: if inCircle(cid)
          && request.resource.data.keys().hasOnly(['by', 'spaceId', 'itemId', 'data', 'w', 'h', 'at', 'v'])
          && request.resource.data.keys().hasAll(['by', 'spaceId', 'itemId', 'data', 'v'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.itemId is string && request.resource.data.itemId.size() <= 130
          && request.resource.data.data is bytes && request.resource.data.data.size() <= 220000
          && (!('w' in request.resource.data) || request.resource.data.w is int)
          && (!('h' in request.resource.data) || request.resource.data.h is int)
          && ownSpaceOrNone(request.resource.data)
          && request.resource.data.v == 1;
        allow update: if false;
        allow delete: if canTakeDown(cid, resource.data.by, resource.data.spaceId);
      }
    }

    // 모임 초대장: 방장만 만든다. 코드를 아는 로그인한 사람이 하나씩 읽는다
    match /circleInvites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.by == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['by', 'circleId', 'circleName', 'createdAt', 'expiresAt', 'v'])
        && request.resource.data.keys().hasAll(['by', 'circleId', 'expiresAt', 'v'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.circleId is string
        && circleHost(request.resource.data.circleId)
        && (!('circleName' in request.resource.data) || (request.resource.data.circleName is string && request.resource.data.circleName.size() <= 20))
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt <= request.time.toMillis() + 8 * 24 * 3600 * 1000
        && request.resource.data.v == 1;
      // 쓰기: 안 쓴 초대장에 내 uid로 한 번만, 기한 안에. 같은 묶음에서 그 모임에 내 구성원 문서가 생겨야 한다
      allow update: if signedIn()
        && !('usedBy' in resource.data)
        && request.time.toMillis() < resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && !exists(circleMemberPath(resource.data.circleId))
        && existsAfter(circleMemberPath(resource.data.circleId));
      allow delete: if signedIn() && (resource.data.by == request.auth.uid || circleHost(resource.data.circleId));
    }

    // ================= 보라핀 사람들에게 공개 (docs/design/SPACES-PUBLIC.md 5절) =================
    // 내가 고른 가게 평의 사본. 보는 사람은 '보라핀 사람'(어느 공간이든 지금 구성원인 사람)뿐이고 인터넷에는 나오지 않는다.
    // - 한 사람이 한 가게에 한 건: 문서 이름 = 가게 번호_내 uid. 가게 번호(카카오 k…, 네이버 n…)가 있는 가게만
    // - '또 갈래요 / 한 번이면 충분'만 공개한다. '별로'는 공개하지 않는다
    // - 메일·위경도·메모·정확한 날짜 칸은 없다 (달까지만). 칸은 hasOnly로 못박는다
    // - 가리기(hidden)는 마을 주인만. 가려진 평은 쓴 사람과 주인만 본다
    function pubReviewPath(id) { return /databases/$(database)/documents/pubReviews/$(id); }
    function flagsPath() { return /databases/$(database)/documents/config/flags; }
    function pubPhotoPath(id) { return /databases/$(database)/documents/pubPhotos/$(id); }
    // 공간 관리자가 그 공간의 공개를 껐는가 (spaces/{공간}.pubOff). 끄면 그 공간 사람은 새로 공개하거나 고치지 못한다. 거두기는 된다.
    // 사진은 평의 목록을 고치는 묶음으로만 올라오므로(pubPhotosOk) 평 쪽에서 막으면 사진도 막힌다.
    function spacePubOff(spaceId) {
      return exists(spaceDocPath(spaceId)) && get(spaceDocPath(spaceId)).data.get('pubOff', false) == true;
    }
    // 공개 사진은 평 하나에 두 칸뿐: 사진 이름 = 평 이름_0 · 평 이름_1. 아무 이름으로나 올려 저장 공간을 쓰지 못한다.
    // 평의 photos 목록과 사진 문서는 늘 맞아야 한다 (이 묶음이 끝난 뒤 모습으로 본다): 적힌 사진은 있고, 안 적힌 사진은 없다.
    // 그래서 사진은 평과 한 묶음(batch)으로만 올리고 지운다. 평에 안 걸린 사진, 사진 없는 이름은 생기지 않는다.
    function pubPhotosOk(d, id) {
      return (!('photos' in d) || (d.photos is list && d.photos.size() <= 2
          && (d.photos.size() < 1 || d.photos[0] in [id + '_0', id + '_1'])
          && (d.photos.size() < 2 || (d.photos[1] in [id + '_0', id + '_1'] && d.photos[1] != d.photos[0]))))
        && ((id + '_0') in d.get('photos', [])) == existsAfter(pubPhotoPath(id + '_0'))
        && ((id + '_1') in d.get('photos', [])) == existsAfter(pubPhotoPath(id + '_1'));
    }
    // 보라핀 지역 모양: 국내 칸 { t: 'kr', code } 또는 나라·도시 { t: 'country', id, city? }
    function validRegion(r) {
      return r is map
        && ((r.keys().hasOnly(['t', 'code']) && r.t == 'kr' && r.code is string && r.code.size() <= 10)
          || (r.keys().hasOnly(['t', 'id', 'city']) && r.keys().hasAll(['t', 'id']) && r.t == 'country'
              && r.id is string && r.id.size() <= 4 && (!('city' in r) || (r.city is string && r.city.size() <= 40))));
    }
    // 올린 시각(at·updatedAt)은 두지 않는다: '지금 여기'에서 바로 공개하면 '이 사람이 지금 이 가게에 있다'가 보인다. 달(month)까지만
    function validPubReview(d, id) {
      return d.keys().hasOnly(['placeKey', 'name', 'kind', 'region', 'tag', 'verdict', 'line', 'nick', 'uid', 'spaceId', 'month', 'photos', 'hidden', 'hiddenReason', 'hiddenAt', 'v'])
        && d.keys().hasAll(['placeKey', 'name', 'kind', 'verdict', 'line', 'nick', 'uid', 'spaceId', 'month', 'hidden', 'v'])
        && d.placeKey is string && d.placeKey.matches('^[kn][0-9]{1,40}$')
        && d.uid == request.auth.uid
        && id == d.placeKey + '_' + request.auth.uid
        // 내가 지금 쓰는 공간 이름으로만 (isUser가 그 공간의 구성원임을 이미 확인했다), 그 공간이 공개를 끄지 않았을 때만
        && d.spaceId is string && d.spaceId == get(profilePath()).data.spaceId
        && !spacePubOff(d.spaceId)
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.kind in ['food', 'cafe', 'sight', 'stay', 'shop', 'etc']
        && (!('region' in d) || validRegion(d.region))
        && (!('tag' in d) || (d.tag is string && d.tag.size() <= 20))
        && d.verdict in ['again', 'once']
        && d.line is string && d.line.size() <= 200
        && d.nick is string && d.nick.size() >= 1 && d.nick.size() <= 10
        && d.month is string && d.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && pubPhotosOk(d, id)
        && d.hidden is bool
        && d.v == 1;
    }
    match /pubReviews/{id} {
      // 목록은 '가려지지 않은 것'(hidden == false)이나 '내 것'(uid == 나)으로 물어야 한다. 주인은 모두.
      // 공간 관리자는 자기 공간 것(spaceId == 내 공간)을 가려진 것까지 모아 읽는다: 공개를 끌 때 모두 거두려고
      allow read: if isUser()
        && (resource.data.hidden == false || resource.data.uid == request.auth.uid || isOwner()
          || spaceAdmin(resource.data.spaceId));
      allow create: if isUser() && validPubReview(request.resource.data, id)
        && request.resource.data.hidden == false
        && !('hiddenReason' in request.resource.data) && !('hiddenAt' in request.resource.data);
      allow update: if
        // 쓴 사람: 내용을 고친다. 가림 상태는 못 바꾼다
        (isUser() && resource.data.uid == request.auth.uid && validPubReview(request.resource.data, id)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hidden', 'hiddenReason', 'hiddenAt']))
        // 마을 주인: 가리기·풀기만. 내용은 못 고친다
        || (isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'hiddenReason', 'hiddenAt'])
          && request.resource.data.hidden is bool
          && (!('hiddenReason' in request.resource.data) || (request.resource.data.hiddenReason is string && request.resource.data.hiddenReason.size() <= 100)));
      // 거두기: 본인, 같은 공간 사람(짝), 마을 주인. 사진도 같은 묶음에서 지워야 한다 (평 없이 남는 사진이 없게)
      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid || isOwner() || inSpace(resource.data.spaceId))
        && !existsAfter(pubPhotoPath(id + '_0')) && !existsAfter(pubPhotoPath(id + '_1'));
    }

    // 공개 사진 사본 (작게 다시 그린 것). 위경도·찍은 시각·올린 시각 칸은 없다.
    // - 하나씩만 읽는다. 평이 가려졌으면(또는 없으면) 쓴 사람과 마을 주인만 본다: 사진 이름은 맞힐 수 있어서 평의 가림을 따라간다
    // - 올리기·지우기는 평의 photos 목록과 한 묶음으로만 (pubPhotosOk와 짝). 고치기는 없다
    match /pubPhotos/{id} {
      allow get: if isUser()
        && (resource.data.uid == request.auth.uid || isOwner()
          || (exists(pubReviewPath(resource.data.reviewId)) && get(pubReviewPath(resource.data.reviewId)).data.hidden == false));
      allow list: if signedIn() && (resource.data.uid == request.auth.uid || isOwner());
      allow create: if isUser()
        && request.resource.data.keys().hasOnly(['uid', 'spaceId', 'reviewId', 'data', 'w', 'h', 'v'])
        && request.resource.data.keys().hasAll(['uid', 'spaceId', 'reviewId', 'data', 'v'])
        && request.resource.data.uid == request.auth.uid
        // 내 평에 붙는 사진만 (평 문서 이름 = 가게 번호_내 uid), 이름은 평 이름_0 · _1
        && request.resource.data.reviewId is string && request.resource.data.reviewId.size() <= 120
        && request.resource.data.reviewId.matches('^[kn][0-9]{1,40}_.+$')
        && request.resource.data.reviewId.split('_').size() == 2
        && request.resource.data.reviewId.split('_')[1] == request.auth.uid
        && id in [request.resource.data.reviewId + '_0', request.resource.data.reviewId + '_1']
        && request.resource.data.data is bytes && request.resource.data.data.size() <= 220000
        && (!('w' in request.resource.data) || (request.resource.data.w is int && request.resource.data.w >= 1 && request.resource.data.w <= 4000))
        && (!('h' in request.resource.data) || (request.resource.data.h is int && request.resource.data.h >= 1 && request.resource.data.h <= 4000))
        && request.resource.data.v == 1
        // 이 묶음이 끝났을 때 내 평이 있고, 그 평의 목록에 이 사진이 적혀 있고, 평과 같은 공간 이름이어야 한다
        && id in getAfter(pubReviewPath(request.resource.data.reviewId)).data.get('photos', [])
        && request.resource.data.spaceId == getAfter(pubReviewPath(request.resource.data.reviewId)).data.spaceId
        // 주인이 공개 사진 올리기를 멈췄으면 못 올린다 (저장 공간 한도를 지키는 스위치)
        && !(exists(flagsPath()) && get(flagsPath()).data.get('pubPhotosPaused', false) == true);
      allow update: if false;
      // 지우기: 본인, 같은 공간 사람(짝), 마을 주인. 평이 같이 지워지거나 평의 목록에서 빠져야 한다
      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid || isOwner() || inSpace(resource.data.spaceId))
        && (!existsAfter(pubReviewPath(resource.data.reviewId))
          || !(id in getAfter(pubReviewPath(resource.data.reviewId)).data.get('photos', [])));
    }

    // 신고: 보라핀 사람이 한 평에 한 번 (문서 이름 = 평 이름_내 uid). 고칠 수 없다. 읽고 지우는 건 마을 주인만
    match /pubFlags/{id} {
      allow create: if isUser()
        && request.resource.data.keys().hasOnly(['reviewId', 'uid', 'reason', 'note', 'at', 'v'])
        && request.resource.data.keys().hasAll(['reviewId', 'uid', 'reason', 'v'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reviewId is string
        && id == request.resource.data.reviewId + '_' + request.auth.uid
        && request.resource.data.reason in ['privacy', 'wrong', 'rude', 'ad', 'other']
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 200))
        && exists(pubReviewPath(request.resource.data.reviewId))
        && request.resource.data.v == 1;
      allow update: if false;
      allow read, delete: if isOwner();
    }

    // 내 모임 목록: 내가 든 모임을 찾는 길 (모임은 목록으로 못 읽는다). 자기 것만, 들어 있는 모임만 적는다
    match /users/{uid}/circles/{cid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'joinedAt', 'updatedAt', 'v'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.v == 1
        && existsAfter(circleMemberPath(cid));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    function validSpace(d) {
      return d.name is string
        && d.name.size() <= 60
        // 우리 집: 이름·시군 코드·위경도·정확히 여부만
        && (!('home' in d) || (
          d.home is map
          && d.home.keys().hasOnly(['label', 'code', 'lat', 'lng', 'exact'])
          && d.home.label is string && d.home.label.size() <= 40
          && d.home.code is string && d.home.code.size() <= 10
          && d.home.lat is number && d.home.lat >= 33 && d.home.lat <= 39
          && d.home.lng is number && d.home.lng >= 124 && d.home.lng <= 132
          && d.home.exact is bool))
        && (!('pubOff' in d) || d.pubOff is bool);
    }

    match /spaces/{spaceId} {
      allow read: if inSpace(spaceId);
      allow update: if inSpace(spaceId) && validSpace(request.resource.data)
        // 만든 사람 칸은 바꾸지 못한다
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        // 공개 끄기(pubOff)는 공간 관리자만 켜고 끈다. 구성원은 그대로 둬야 한다
        && (request.resource.data.get('pubOff', false) == resource.data.get('pubOff', false) || spaceAdmin(spaceId));
      // 만들기: 우리 공간은 예전대로. 새 공간은 같은 묶음에서 초대장으로 첫 관리자가 되는 사람만 (규칙 validInvitedMember)
      allow create: if validSpace(request.resource.data)
        && (
          (spaceId == 'main' && isMember() && (request.resource.data.get('pubOff', false) == false || isAdmin()))
          || (spaceId != 'main' && signedIn()
            && !exists(memberPath(spaceId))
            && existsAfter(memberPath(spaceId))
            && getAfter(memberPath(spaceId)).data.role == 'admin'
            && request.resource.data.createdBy == request.auth.uid)
        );
      allow delete: if false;

      // 구성원 문서: 같은 공간 사람끼리 본다.
      // - 우리 공간(main): 옛 목록에 있는 사람이 자기 것을 만들고 고친다 (문은 아직 옛 목록)
      // - 그 밖의 공간: 초대장으로만 생긴다. 자기 이름·관계만 고친다. 역할은 바뀌지 않는다
      //   (관리자는 공간을 연 한 사람. 스스로 나갈 수 없어서 관리자 없는 공간이 생기지 않는다)
      match /members/{uid} {
        allow read: if inSpace(spaceId);
        allow create: if (spaceId == 'main' && isMember() && request.auth.uid == uid && validLegacyMember(request.resource.data))
          || (spaceId != 'main' && signedIn() && request.auth.uid == uid && validInvitedMember(spaceId, request.resource.data));
        allow update: if (spaceId == 'main' && isMember() && request.auth.uid == uid && validLegacyMember(request.resource.data))
          || (spaceId != 'main' && inSpace(spaceId) && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'relation', 'updatedAt'])
            && validMemberBasics(request.resource.data));
        allow delete: if (spaceId == 'main' && isMember() && (request.auth.uid == uid || isAdmin()))
          || (spaceId != 'main' && (
            // 구성원이 스스로 나가기
            (inSpace(spaceId) && request.auth.uid == uid && resource.data.role != 'admin')
            // 관리자가 남을 내보내기
            || (spaceAdmin(spaceId) && request.auth.uid != uid)));
      }

      match /trips/{tripId} {
        allow read: if inSpace(spaceId);
        allow create, update: if inSpace(spaceId) && validTrip(request.resource.data);
        allow delete: if inSpace(spaceId);
      }

      match /places/{placeId} {
        allow read: if inSpace(spaceId);
        allow create, update: if inSpace(spaceId) && validPlace(request.resource.data);
        allow delete: if inSpace(spaceId);
      }

      // 내 지도: 지역×주제 묶음의 제목·소개·순위·공개 토큰 (문서 이름 'kr:11|cafe')
      match /placeMaps/{mapId} {
        allow read: if inSpace(spaceId);
        allow create, update: if inSpace(spaceId) && validPlaceMap(request.resource.data);
        allow delete: if inSpace(spaceId);
      }

      match /photos/{photoId} {
        allow read: if inSpace(spaceId);
        allow create, update: if inSpace(spaceId) && validPhoto(request.resource.data);
        allow delete: if inSpace(spaceId);
      }

      // 사진 파일 (크게 보기 _l, 미리보기 _t). 공유 링크에 들어간 사진만 로그인 없이 하나씩 읽힌다.
      match /photoData/{dataId} {
        allow get: if inSpace(spaceId) || resource.data.public == true;
        allow list: if inSpace(spaceId);
        allow create: if inSpace(spaceId)
          && request.resource.data.keys().hasOnly(['photoId', 'tripId', 'kind', 'data', 'size', 'public', 'v'])
          && request.resource.data.photoId is string
          && dataId == request.resource.data.photoId + '_' + request.resource.data.kind
          && request.resource.data.kind in ['l', 't']
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 950 * 1024
          && request.resource.data.public == false
          && request.resource.data.v == 1
          // 관리자가 사진 올리기를 멈췄으면 옛 버전 앱에서도 올리지 못하게
          && !(exists(/databases/$(database)/documents/config/flags)
               && get(/databases/$(database)/documents/config/flags).data.get('uploadsPaused', false) == true);
        // 바꿀 수 있는 건 공개 여부뿐
        allow update: if inSpace(spaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['public'])
          && request.resource.data.public is bool;
        allow delete: if inSpace(spaceId);
      }

      match /plans/{planId} {
        allow read: if inSpace(spaceId);
        allow create, update: if inSpace(spaceId) && validPlan(request.resource.data);
        allow delete: if inSpace(spaceId);
      }

      match /notes/{noteId} {
        allow read: if inSpace(spaceId);
        allow create: if inSpace(spaceId) && validNote(request.resource.data);
        allow update: if false;
        // 글은 쓴 사람만 지운다. 다만 여행을 통째로 지울 때는 남의 글도 함께 지운다:
        // 그 글의 여행 문서가 이 요청(묶음) 뒤에 없으면(같은 묶음에서 지워지거나 이미 없으면) 허용 (deleteTripAll)
        allow delete: if inSpace(spaceId)
          && (resource.data.by.uid == request.auth.uid
            || !existsAfter(/databases/$(database)/documents/spaces/$(spaceId)/trips/$(resource.data.tripId)));
      }

      match /wishes/{wishId} {
        allow read: if inSpace(spaceId);
        allow create, update: if inSpace(spaceId) && validWish(request.resource.data);
        allow delete: if inSpace(spaceId);
      }

      // 영어 공부 진도: 사람마다 문서 하나(uid). 자기 것만 읽고 쓴다
      match /study/{uid} {
        allow read, write: if inSpace(spaceId) && uid == request.auth.uid
          && (request.method == 'get' || request.method == 'delete' || (
            request.resource.data.keys().hasOnly(['progress', 'days', 'v'])
            && request.resource.data.progress is map
            && request.resource.data.days is list && request.resource.data.days.size() <= 1000
            && request.resource.data.v == 1));
      }

      // 여행 계획하기: 후보 3곳에 둘이 각자 하트. 만든 사람이 후보를 정하고, 다른 사람은 자기 하트 칸만 바꾼다
      match /planDrafts/{id} {
        allow read: if inSpace(spaceId);
        allow create: if inSpace(spaceId)
          && request.resource.data.keys().hasOnly(['conds', 'cands', 'hearts', 'names', 'by', 'createdAt', 'tripId', 'round', 'v'])
          && request.resource.data.cands is list && request.resource.data.cands.size() <= 6
          && request.resource.data.by.uid == request.auth.uid
          && request.resource.data.v == 1;
        allow update: if inSpace(spaceId)
          && request.resource.data.keys().hasOnly(['conds', 'cands', 'hearts', 'names', 'by', 'createdAt', 'tripId', 'round', 'v'])
          && request.resource.data.by == resource.data.by
          && request.resource.data.cands is list && request.resource.data.cands.size() <= 6
          && (
            // 하트·이름: 자기 칸만
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts', 'names'])
              && request.resource.data.hearts.diff(resource.data.hearts).affectedKeys().hasOnly([request.auth.uid])
              && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid]))
            // 정하기(여행 만들기)는 누구나
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tripId'])
            // 다시 고르기: 후보를 바꾸면 하트는 모두 비운다 (남의 하트를 바꾸는 길이 되지 않게)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cands', 'hearts', 'round'])
              && request.resource.data.hearts.size() == 0)
          );
        allow delete: if inSpace(spaceId) && resource.data.by.uid == request.auth.uid;
      }

      // 오늘의 한 질문: 날짜마다 문서 하나. answers = { uid: {name, text, at} }, 자기 칸만 쓴다
      match /asks/{day} {
        allow read: if inSpace(spaceId);
        allow create: if inSpace(spaceId)
          && request.resource.data.keys().hasOnly(['qid', 'place', 'answers', 'v'])
          && request.resource.data.qid is string && request.resource.data.place is map
          && request.resource.data.answers is map
          && request.resource.data.answers.keys().hasOnly([request.auth.uid])
          && request.resource.data.v == 1;
        allow update: if inSpace(spaceId)
          && request.resource.data.keys().hasOnly(['qid', 'place', 'answers', 'v'])
          && request.resource.data.qid == resource.data.qid
          && request.resource.data.answers.diff(resource.data.answers).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.answers[request.auth.uid].text is string
          && request.resource.data.answers[request.auth.uid].text.size() <= 200;
        allow delete: if false;
      }

      // 피드 하트: 문서 하나 = 피드 항목 하나, by = { uid: 이름 }. 자기 uid 칸만 넣고 뺀다
      match /hearts/{itemKey} {
        allow read: if inSpace(spaceId);
        allow create: if inSpace(spaceId)
          && request.resource.data.keys().hasOnly(['by', 'v', 'at'])
          && request.resource.data.by is map
          && request.resource.data.by.keys().hasOnly([request.auth.uid])
          && request.resource.data.v == 1;
        allow update: if inSpace(spaceId)
          && request.resource.data.keys().hasOnly(['by', 'v', 'at'])
          && request.resource.data.by is map
          && request.resource.data.by.size() <= 20
          && request.resource.data.by.diff(resource.data.by).affectedKeys().hasOnly([request.auth.uid]);
        allow delete: if false;
      }
    }

    // 그 밖의 모든 경로는 막는다
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
