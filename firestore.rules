rules_version = '2';

// 보라핀 보안 규칙
// - 허용 목록(config/access.allowed)에 있는 구글 계정만 읽고 쓸 수 있다.
// - 주인 계정(OWNER)은 허용 목록이 비어 있어도 들어와 처음 설정을 만들 수 있다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && email() == 'ysangyn@gmail.com'; }
    function accessDoc() { return get(/databases/$(database)/documents/config/access); }
    function isMember() {
      return isOwner()
        || (signedIn()
            && exists(/databases/$(database)/documents/config/access)
            && email() in accessDoc().data.allowed);
    }
    function isAdmin() {
      return isOwner() || (isMember() && email() in accessDoc().data.admins);
    }

    // 멤버가 앱에서 쓸 자기 이름만 바꾼다: names.<내 메일> 한 칸만, 1~10자
    function renamingSelf() {
      let me = request.auth.token.email.lower();
      return isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names', 'updatedAt'])
        && request.resource.data.names is map
        && request.resource.data.names.diff(resource.data.get('names', {})).affectedKeys().hasOnly([me])
        && me in request.resource.data.names
        && request.resource.data.names[me] is string
        && request.resource.data.names[me].size() >= 1 && request.resource.data.names[me].size() <= 10
        && validAccess(request.resource.data);
    }

    function validAccess(d) {
      return d.keys().hasOnly(['allowed', 'admins', 'names', 'relations', 'updatedAt', 'via'])
        && (!('names' in d) || (d.names is map && d.names.size() <= 50))
        && (!('relations' in d) || (d.relations is map && d.relations.size() <= 50))
        && d.allowed is list && d.allowed.size() <= 50
        && d.admins is list && d.admins.size() <= 10;
    }

    function validTrip(d) {
      return d.keys().hasAll(['title', 'kind', 'status', 'when', 'places', 'v'])
        && d.title is string && d.title.size() <= 100
        && d.kind in ['trip', 'outing']
        && d.status in ['done', 'planned']
        && d.when is map
        && d.places is list && d.places.size() >= 1 && d.places.size() <= 50
        && (!('companions' in d) || (d.companions is list && d.companions.size() <= 30))
        && (!('memo' in d) || (d.memo is string && d.memo.size() <= 10000))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 30))
        && (!('packing' in d) || (d.packing is list && d.packing.size() <= 200))
        && (!('stay' in d) || d.stay == null || (d.stay is map && d.stay.name is string && d.stay.name.size() <= 80))
        && (!('hopes' in d) || (d.hopes is map && d.hopes.size() <= 10))
        && optList(d, 'planDone', 10)
        && d.v == 1;
    }

    function optList(d, k, n) { return !(k in d) || (d[k] is list && d[k].size() <= n); }

    function validWish(d) {
      return d.keys().hasAll(['place', 'v'])
        && d.place is map
        && (!('note' in d) || (d.note is string && d.note.size() <= 5000))
        && (!('spotName' in d) || (d.spotName is string && d.spotName.size() <= 60))
        && optList(d, 'wantedBy', 10) && optList(d, 'links', 20) && optList(d, 'months', 12)
        && optList(d, 'spots', 50) && optList(d, 'todos', 50) && optList(d, 'foods', 50)
        && (!('priority' in d) || d.priority == null || d.priority in [1, 2, 3])
        && d.v == 1;
    }

    function validPlace(d) {
      return d.keys().hasAll(['name', 'kind', 'region', 'v'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.kind in ['food', 'cafe', 'sight', 'stay', 'shop', 'etc']
        && d.region is map
        && (!('reviews' in d) || (d.reviews is map && d.reviews.size() <= 10))
        && (!('verdict' in d) || d.verdict == null || d.verdict in ['again', 'once', 'meh'])
        && (!('naverUrl' in d) || (d.naverUrl is string && d.naverUrl.size() <= 500))
        && (!('memo' in d) || (d.memo is string && d.memo.size() <= 5000))
        && (!('photoUrl' in d) || (d.photoUrl is string && d.photoUrl.size() <= 600 && d.photoUrl.matches('https://.*')))
        && (!('lat' in d) || (d.lat is number && d.lat >= -90 && d.lat <= 90))
        && (!('lng' in d) || (d.lng is number && d.lng >= -180 && d.lng <= 180))
        && d.v == 1;
    }

    function validPhoto(d) {
      return d.keys().hasAll(['w', 'h', 'bytes', 'v'])
        && d.w is int && d.h is int
        && d.bytes is int && d.bytes < 2 * 1024 * 1024
        && (!('caption' in d) || (d.caption is string && d.caption.size() <= 500))
        && d.v == 1;
    }

    function validPlan(d) {
      return d.keys().hasAll(['tripId', 'name', 'v'])
        && d.tripId is string && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && (!('info' in d) || (d.info is string && d.info.size() <= 200))
        && optList(d, 'by', 10)
        && (!('img' in d) || (d.img is string && d.img.size() <= 500))
        && d.v == 1;
    }
    function validNote(d) {
      return d.keys().hasAll(['tripId', 'text', 'by', 'v'])
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 5000
        && d.by.uid == request.auth.uid
        // 타임캡슐: 열리는 날 'YYYY-MM-DD' (선택)
        && (!('openAt' in d) || (d.openAt is string && d.openAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && d.v == 1;
    }

    // 초대 링크: 관리자가 만든 코드(문서 이름)로 들어온 사람이 자기 메일을 허용 목록에 넣는다 (서버 없이)
    function inviteOf(code) { return get(/databases/$(database)/documents/invites/$(code)); }
    function joiningByInvite() {
      let d = request.resource.data;
      let old = resource.data;
      return signedIn() && !isMember()
        && d.keys().hasOnly(['allowed', 'admins', 'names', 'relations', 'updatedAt', 'via'])
        && d.via is string && d.via.size() >= 8 && d.via.size() <= 64
        && exists(/databases/$(database)/documents/invites/$(d.via))
        && inviteOf(d.via).data.usedBy == email()
        // 바뀌는 건 내 메일 한 줄(과 내 이름)뿐
        && d.admins == old.admins
        && d.allowed.hasAll(old.allowed) && d.allowed.size() == old.allowed.size() + 1 && d.allowed.size() <= 50
        && email() in d.allowed
        && d.get('names', {}).diff(old.get('names', {})).affectedKeys().hasOnly([email()])
        && d.get('relations', {}).diff(old.get('relations', {})).affectedKeys().hasOnly([email()]);
    }

    match /config/access {
      allow read: if isMember();
      allow create: if isOwner() && validAccess(request.resource.data);
      allow update: if (isAdmin() && validAccess(request.resource.data)
        // 주인 계정은 허용·관리자 목록에서 빠지지 않게
        && 'ysangyn@gmail.com' in request.resource.data.allowed
        && 'ysangyn@gmail.com' in request.resource.data.admins)
        || joiningByInvite()
        || renamingSelf();
      allow delete: if false;
    }

    // 초대: 문서 이름이 코드. 관리자가 만들고(7일), 링크로 온 사람이 자기 메일로 '썼음' 표시를 한 번만 한다
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['by', 'name', 'relation', 'createdAt', 'expiresAt', 'v'])
        && request.resource.data.by == email()
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 20))
        && (!('relation' in request.resource.data) || request.resource.data.relation in ['spouse', 'partner', 'family', 'friend', 'relative', 'other'])
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt <= request.time.toMillis() + 8 * 24 * 3600 * 1000
        && request.resource.data.v == 1;
      allow update: if signedIn()
        && !('usedBy' in resource.data)
        && request.time.toMillis() < resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == email();
      allow delete: if isAdmin();
    }

    // 앱 스위치(사진 올리기 멈춤 등): 멤버는 읽고 관리자만 바꾼다
    match /config/flags {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // 오류 기록·문제 신고: 멤버가 남기고 관리자가 보고 지운다
    match /reports/{id} {
      allow create: if isMember()
        && request.resource.data.kind in ['error', 'report']
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && (!('detail' in request.resource.data) || (request.resource.data.detail is string && request.resource.data.detail.size() <= 3000));
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // 링크 공개된 여행 사본: 토큰을 아는 사람만 하나씩 읽을 수 있다 (목록 조회 불가)
    match /shares/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isMember()
        && request.resource.data.keys().hasAll(['title', 'when', 'places', 'photos', 'v'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.photos is list && request.resource.data.photos.size() <= 60
        && !('memo' in request.resource.data) && !('companions' in request.resource.data);
      allow delete: if isMember();
    }

    // 지금은 우리 공간(main) 하나만 있다. 다른 공간 이름으로는 읽지도 쓰지도 못한다.
    // (나중에 여러 커플이 쓰게 되면 공간마다 멤버 목록을 두고 이 함수만 바꾸면 된다)
    function inSpace(spaceId) { return spaceId == 'main' && isMember(); }

    match /spaces/{spaceId} {
      allow read: if inSpace(spaceId);
      allow create, update: if inSpace(spaceId)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        // 우리 집: 이름·시군 코드·위경도·정확히 여부만
        && (!('home' in request.resource.data) || (
          request.resource.data.home is map
          && request.resource.data.home.keys().hasOnly(['label', 'code', 'lat', 'lng', 'exact'])
          && request.resource.data.home.label is string && request.resource.data.home.label.size() <= 40
          && request.resource.data.home.code is string && request.resource.data.home.code.size() <= 10
          && request.resource.data.home.lat is number && request.resource.data.home.lat >= 33 && request.resource.data.home.lat <= 39
          && request.resource.data.home.lng is number && request.resource.data.home.lng >= 124 && request.resource.data.home.lng <= 132
          && request.resource.data.home.exact is bool));
      allow delete: if false;

      match /trips/{tripId} {
        allow read: if inSpace(spaceId);
        allow create, update: if inSpace(spaceId) && validTrip(request.resource.data);
        allow delete: if inSpace(spaceId);
      }

      match /places/{placeId} {
        allow read: if inSpace(spaceId);
        allow create, update: if inSpace(spaceId) && validPlace(request.resource.data);
        allow delete: if inSpace(spaceId);
      }

      match /photos/{photoId} {
        allow read: if inSpace(spaceId);
        allow create, update: if inSpace(spaceId) && validPhoto(request.resource.data);
        allow delete: if inSpace(spaceId);
      }

      // 사진 파일 (크게 보기 _l, 미리보기 _t). 공유 링크에 들어간 사진만 로그인 없이 하나씩 읽힌다.
      match /photoData/{dataId} {
        allow get: if inSpace(spaceId) || resource.data.public == true;
        allow list: if inSpace(spaceId);
        allow create: if inSpace(spaceId)
          && request.resource.data.keys().hasOnly(['photoId', 'tripId', 'kind', 'data', 'size', 'public', 'v'])
          && request.resource.data.photoId is string
          && dataId == request.resource.data.photoId + '_' + request.resource.data.kind
          && request.resource.data.kind in ['l', 't']
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 950 * 1024
          && request.resource.data.public == false
          && request.resource.data.v == 1
          // 관리자가 사진 올리기를 멈췄으면 옛 버전 앱에서도 올리지 못하게
          && !(exists(/databases/$(database)/documents/config/flags)
               && get(/databases/$(database)/documents/config/flags).data.get('uploadsPaused', false) == true);
        // 바꿀 수 있는 건 공개 여부뿐
        allow update: if inSpace(spaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['public'])
          && request.resource.data.public is bool;
        allow delete: if inSpace(spaceId);
      }

      match /plans/{planId} {
        allow read: if inSpace(spaceId);
        allow create, update: if inSpace(spaceId) && validPlan(request.resource.data);
        allow delete: if inSpace(spaceId);
      }

      match /notes/{noteId} {
        allow read: if inSpace(spaceId);
        allow create: if inSpace(spaceId) && validNote(request.resource.data);
        allow update: if false;
        // 글은 쓴 사람만 지운다. 다만 여행을 통째로 지울 때는 남의 글도 함께 지운다:
        // 그 글의 여행 문서가 이 요청(묶음) 뒤에 없으면(같은 묶음에서 지워지거나 이미 없으면) 허용 (deleteTripAll)
        allow delete: if inSpace(spaceId)
          && (resource.data.by.uid == request.auth.uid
            || !existsAfter(/databases/$(database)/documents/spaces/$(spaceId)/trips/$(resource.data.tripId)));
      }

      match /wishes/{wishId} {
        allow read: if inSpace(spaceId);
        allow create, update: if inSpace(spaceId) && validWish(request.resource.data);
        allow delete: if inSpace(spaceId);
      }

      // 영어 공부 진도: 사람마다 문서 하나(uid). 자기 것만 읽고 쓴다
      match /study/{uid} {
        allow read, write: if inSpace(spaceId) && uid == request.auth.uid
          && (request.method == 'get' || request.method == 'delete' || (
            request.resource.data.keys().hasOnly(['progress', 'days', 'v'])
            && request.resource.data.progress is map
            && request.resource.data.days is list && request.resource.data.days.size() <= 1000
            && request.resource.data.v == 1));
      }

      // 여행 계획하기: 후보 3곳에 둘이 각자 하트. 만든 사람이 후보를 정하고, 다른 사람은 자기 하트 칸만 바꾼다
      match /planDrafts/{id} {
        allow read: if inSpace(spaceId);
        allow create: if inSpace(spaceId)
          && request.resource.data.keys().hasOnly(['conds', 'cands', 'hearts', 'names', 'by', 'createdAt', 'tripId', 'round', 'v'])
          && request.resource.data.cands is list && request.resource.data.cands.size() <= 6
          && request.resource.data.by.uid == request.auth.uid
          && request.resource.data.v == 1;
        allow update: if inSpace(spaceId)
          && request.resource.data.keys().hasOnly(['conds', 'cands', 'hearts', 'names', 'by', 'createdAt', 'tripId', 'round', 'v'])
          && request.resource.data.by == resource.data.by
          && request.resource.data.cands is list && request.resource.data.cands.size() <= 6
          && (
            // 하트·이름: 자기 칸만
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts', 'names'])
              && request.resource.data.hearts.diff(resource.data.hearts).affectedKeys().hasOnly([request.auth.uid])
              && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid]))
            // 정하기(여행 만들기)는 누구나
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tripId'])
            // 다시 고르기: 후보를 바꾸면 하트는 모두 비운다 (남의 하트를 바꾸는 길이 되지 않게)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cands', 'hearts', 'round'])
              && request.resource.data.hearts.size() == 0)
          );
        allow delete: if inSpace(spaceId) && resource.data.by.uid == request.auth.uid;
      }

      // 오늘의 한 질문: 날짜마다 문서 하나. answers = { uid: {name, text, at} }, 자기 칸만 쓴다
      match /asks/{day} {
        allow read: if inSpace(spaceId);
        allow create: if inSpace(spaceId)
          && request.resource.data.keys().hasOnly(['qid', 'place', 'answers', 'v'])
          && request.resource.data.qid is string && request.resource.data.place is map
          && request.resource.data.answers is map
          && request.resource.data.answers.keys().hasOnly([request.auth.uid])
          && request.resource.data.v == 1;
        allow update: if inSpace(spaceId)
          && request.resource.data.keys().hasOnly(['qid', 'place', 'answers', 'v'])
          && request.resource.data.qid == resource.data.qid
          && request.resource.data.answers.diff(resource.data.answers).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.answers[request.auth.uid].text is string
          && request.resource.data.answers[request.auth.uid].text.size() <= 200;
        allow delete: if false;
      }

      // 피드 하트: 문서 하나 = 피드 항목 하나, by = { uid: 이름 }. 자기 uid 칸만 넣고 뺀다
      match /hearts/{itemKey} {
        allow read: if inSpace(spaceId);
        allow create: if inSpace(spaceId)
          && request.resource.data.keys().hasOnly(['by', 'v', 'at'])
          && request.resource.data.by is map
          && request.resource.data.by.keys().hasOnly([request.auth.uid])
          && request.resource.data.v == 1;
        allow update: if inSpace(spaceId)
          && request.resource.data.keys().hasOnly(['by', 'v', 'at'])
          && request.resource.data.by is map
          && request.resource.data.by.size() <= 20
          && request.resource.data.by.diff(resource.data.by).affectedKeys().hasOnly([request.auth.uid]);
        allow delete: if false;
      }
    }

    // 그 밖의 모든 경로는 막는다
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
