rules_version = '2';

// 보라핀 사진 저장소 규칙
// - 허용 목록(Firestore config/access)에 있는 계정만 사진을 보고 올리고 지울 수 있다.
// - 압축본(긴 변 2000px)과 미리보기만 올리므로 한 장 6MB를 넘지 않는다.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email.lower(); }
    function isMember() {
      return signedIn() && (
        email() == 'ysangyn@gmail.com'
        || email() in firestore.get(/databases/(default)/documents/config/access).data.allowed
      );
    }

    match /spaces/{space}/photos/{photoId}/{file} {
      allow read: if isMember();
      allow create: if isMember()
        && file in ['l.jpg', 't.jpg']
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if isMember();
      allow update: if false;
    }

    match /{all=**} {
      allow read, write: if false;
    }
  }
}
