      { "id": "em5", "en": "Please call an ambulance.", "ko": "구급차를 불러 주세요.", "words": [["ambulance", "구급차"]] },
      { "id": "em6", "en": "Could you help me, please?", "ko": "좀 도와주시겠어요?", "words": [["help", "돕다"]] },
      { "id": "em7", "en": "I left my bag on the train.", "ko": "가방을 기차에 두고 내렸어요.", "words": [["leave (something)", "두고 오다"]] },
      { "id": "em8", "en": "Is there a lost and found?", "ko": "분실물 센터가 있나요?", "words": [["lost and found", "분실물 센터"]] },
      { "id": "em9", "en": "My card was declined.", "ko": "제 카드가 거절됐어요.", "words": [["declined", "거절된"]] },
      { "id": "em10", "en": "Does anyone here speak Korean?", "ko": "여기 한국어 하시는 분 있나요?", "words": [["speak", "말하다"]] }
    ]},
    { "id": "smalltalk", "label": "인사·대화", "items": [
      { "id": "sm1", "en": "We're from Korea.", "ko": "저희는 한국에서 왔어요.", "words": [["from", "~에서 온"]] },
      { "id": "sm2", "en": "This is our first trip here.", "ko": "여기는 처음 와 봐요.", "words": [["trip", "여행"]] },
      { "id": "sm3", "en": "The weather is lovely today.", "ko": "오늘 날씨 참 좋네요.", "words": [["lovely", "아주 좋은"]] },
      { "id": "sm4", "en": "What do locals usually eat here?", "ko": "여기 현지 사람들은 보통 뭘 먹어요?", "words": [["locals", "현지 사람들"]] },
      { "id": "sm5", "en": "That's so kind of you.", "ko": "정말 친절하시네요.", "words": [["kind", "친절한"]] },
      { "id": "sm6", "en": "We're celebrating our anniversary.", "ko": "저희 결혼기념일을 기념하는 중이에요.", "words": [["anniversary", "기념일"]] },
      { "id": "sm7", "en": "Could you recommend a quiet place nearby?", "ko": "근처에 조용한 곳 추천해 주실 수 있나요?", "words": [["quiet", "조용한"]] },
      { "id": "sm8", "en": "Have a nice day!", "ko": "좋은 하루 보내세요!", "words": [["have a nice day", "좋은 하루 보내세요"]] },
      { "id": "sm9", "en": "Sorry, my English isn't very good.", "ko": "죄송해요, 제가 영어를 잘 못해요.", "words": [["not very good", "별로 잘하지 못하는"]] },
      { "id": "sm10", "en": "It was nice talking to you.", "ko": "이야기 나눠서 즐거웠어요.", "words": [["nice talking to you", "이야기 나눠 즐거웠어요"]] }
    ]},
    { "id": "booking", "label": "예약·변경", "items": [
      { "id": "bo1", "en": "I'd like to book a table for tonight at seven.", "ko": "오늘 저녁 7시에 자리를 예약하고 싶어요.", "words": [["book", "예약하다"]] },
      { "id": "bo2", "en": "Can I change my reservation to Friday?", "ko": "예약을 금요일로 바꿀 수 있을까요?", "words": [["change", "바꾸다"]] },
      { "id": "bo3", "en": "I'd like to cancel my booking.", "ko": "예약을 취소하고 싶어요.", "words": [["cancel", "취소하다"]] },
      { "id": "bo4", "en": "Is there a cancellation fee?", "ko": "취소 수수료가 있나요?", "words": [["fee", "수수료"]] },
      { "id": "bo5", "en": "Do you have anything available tomorrow?", "ko": "내일 가능한 게 있나요?", "words": [["available", "이용 가능한"]] },
      { "id": "bo6", "en": "Could you send me a confirmation email?", "ko": "확인 메일을 보내 주시겠어요?", "words": [["confirmation", "확인"]] },
      { "id": "bo7", "en": "We'll be a little late.", "ko": "저희가 조금 늦을 것 같아요.", "words": [["late", "늦은"]] },
      { "id": "bo8", "en": "Is breakfast included?", "ko": "아침 식사가 포함돼 있나요?", "words": [["included", "포함된"]] },
      { "id": "bo9", "en": "Can I extend my stay by one night?", "ko": "하룻밤 더 연장할 수 있을까요?", "words": [["extend", "연장하다"]] },
      { "id": "bo10", "en": "What's your refund policy?", "ko": "환불 규정이 어떻게 되나요?", "words": [["refund policy", "환불 규정"]] }
    ]},
    { "id": "numbers", "label": "시간·숫자·돈", "items": [
      { "id": "nu1", "en": "It's a quarter past nine.", "ko": "9시 15분이에요.", "words": [["a quarter past", "~시 15분"]] },
      { "id": "nu2", "en": "We'll meet at half past six.", "ko": "6시 반에 만나요.", "words": [["half past", "~시 30분"]] },
      { "id": "nu3", "en": "That comes to twenty-four fifty.", "ko": "다 해서 24달러 50센트예요.", "words": [["come to", "합계가 ~가 되다"]] },
      { "id": "nu4", "en": "Could you break a hundred for me?", "ko": "100달러를 잔돈으로 바꿔 주실 수 있나요?", "words": [["break (a bill)", "잔돈으로 바꾸다"]] },
      { "id": "nu5", "en": "It's about a fifteen-minute walk.", "ko": "걸어서 15분쯤 걸려요.", "words": [["about", "약, 대략"]] },
      { "id": "nu6", "en": "The exchange rate is better downtown.", "ko": "환율은 시내가 더 좋아요.", "words": [["exchange rate", "환율"]] },
      { "id": "nu7", "en": "Is tipping expected here?", "ko": "여기선 팁을 줘야 하나요?", "words": [["tipping", "팁 주기"], ["expected", "기대되는"]] },
      { "id": "nu8", "en": "The shop opens at ten and closes at eight.", "ko": "가게는 10시에 열고 8시에 닫아요.", "words": [["open", "열다"]] },
      { "id": "nu9", "en": "We have about an hour left.", "ko": "한 시간쯤 남았어요.", "words": [["left", "남은"]] },
      { "id": "nu10", "en": "It's twice the price of the other one.", "ko": "다른 것의 두 배 가격이에요.", "words": [["twice", "두 배"]] }
    ]},
    { "id": "weather", "label": "날씨·계절", "items": [
      { "id": "we1", "en": "It looks like it's going to rain.", "ko": "비가 올 것 같아요.", "words": [["look like", "~인 것 같다"]] },
      { "id": "we2", "en": "Should we bring an umbrella?", "ko": "우산을 가져가야 할까요?", "words": [["umbrella", "우산"]] },
      { "id": "we3", "en": "It's chilly in the morning.", "ko": "아침에는 쌀쌀해요.", "words": [["chilly", "쌀쌀한"]] },
      { "id": "we4", "en": "The leaves are turning red.", "ko": "단풍이 들고 있어요.", "words": [["turn (a color)", "~색으로 변하다"]] },
      { "id": "we5", "en": "It's humid, isn't it?", "ko": "습하네요, 그렇죠?", "words": [["humid", "습한"]] },
      { "id": "we6", "en": "The sunset here is beautiful.", "ko": "여기 노을이 아름다워요.", "words": [["sunset", "노을, 일몰"]] },
      { "id": "we7", "en": "What's the forecast for tomorrow?", "ko": "내일 일기예보가 어때요?", "words": [["forecast", "일기예보"]] },
      { "id": "we8", "en": "It's the perfect season to visit.", "ko": "방문하기 딱 좋은 계절이에요.", "words": [["perfect", "완벽한"]] },
      { "id": "we9", "en": "We got caught in the rain.", "ko": "비를 만났어요.", "words": [["get caught in", "(비 등을) 만나다"]] },
      { "id": "we10", "en": "Let's wait until the rain stops.", "ko": "비가 그칠 때까지 기다리죠.", "words": [["wait until", "~까지 기다리다"]] }
    ]},
    { "id": "photos", "label": "사진·추억", "items": [
      { "id": "pi1", "en": "Could you take one more, just in case?", "ko": "혹시 모르니 한 장만 더 찍어 주시겠어요?", "words": [["just in case", "혹시 모르니"]] },
      { "id": "pi2", "en": "Can you get the tower in the background?", "ko": "뒤에 탑이 나오게 찍어 주실 수 있나요?", "words": [["in the background", "배경에"]] },
      { "id": "pi3", "en": "Would you like me to take one of you?", "ko": "제가 당신 사진도 찍어 드릴까요?", "words": [["would you like", "~하시겠어요"]] },
      { "id": "pi4", "en": "This place brings back memories.", "ko": "여기 오니 옛 추억이 떠올라요.", "words": [["bring back memories", "추억을 떠올리게 하다"]] },
      { "id": "pi5", "en": "Say cheese!", "ko": "김치! (사진 찍을 때)", "words": [["say cheese", "(사진) 웃으세요"]] },
      { "id": "pi6", "en": "The lighting is better over there.", "ko": "저쪽이 빛이 더 좋아요.", "words": [["lighting", "조명, 빛"]] },
      { "id": "pi7", "en": "Can I take a photo of the menu?", "ko": "메뉴 사진 찍어도 되나요?", "words": [["menu", "메뉴"]] },
      { "id": "pi8", "en": "We came here five years ago.", "ko": "저희 5년 전에 여기 왔었어요.", "words": [["ago", "~전에"]] },
      { "id": "pi9", "en": "It hasn't changed at all.", "ko": "하나도 안 변했네요.", "words": [["at all", "전혀"]] },
      { "id": "pi10", "en": "Let's come back here someday.", "ko": "언젠가 여기 다시 오자.", "words": [["someday", "언젠가"]] }
    ]},
    { "id": "car", "label": "렌터카·운전", "items": [
      { "id": "cr1", "en": "I'd like to pick up my rental car.", "ko": "예약한 렌터카를 찾으러 왔어요.", "words": [["pick up", "찾아가다"], ["rental car", "렌터카"]] },
      { "id": "cr2", "en": "Does the price include insurance?", "ko": "가격에 보험이 포함돼 있나요?", "words": [["insurance", "보험"]] },
      { "id": "cr3", "en": "Where's the nearest gas station?", "ko": "가장 가까운 주유소가 어디예요?", "words": [["gas station", "주유소"]] },
      { "id": "cr4", "en": "Fill it up with regular, please.", "ko": "일반 휘발유로 가득 채워 주세요.", "words": [["fill it up", "가득 채우다"]] },
      { "id": "cr5", "en": "Is parking free here?", "ko": "여기 주차 무료예요?", "words": [["parking", "주차"]] },
      { "id": "cr6", "en": "How do I pay the toll?", "ko": "통행료는 어떻게 내요?", "words": [["toll", "통행료"]] },
      { "id": "cr7", "en": "The car is making a strange noise.", "ko": "차에서 이상한 소리가 나요.", "words": [["strange noise", "이상한 소리"]] },
      { "id": "cr8", "en": "Can I return the car at the airport?", "ko": "차를 공항에서 반납해도 되나요?", "words": [["return", "반납하다"]] },
      { "id": "cr9", "en": "Is this road open in winter?", "ko": "이 길은 겨울에도 열려 있나요?", "words": [["open", "열린, 통행 가능한"]] },
      { "id": "cr10", "en": "We got a flat tire.", "ko": "타이어에 펑크가 났어요.", "words": [["flat tire", "펑크 난 타이어"]] }
    ]},
    { "id": "couple", "label": "둘이 여행할 때", "items": [
      { "id": "co1", "en": "Let's take it slow today.", "ko": "오늘은 천천히 다니자.", "words": [["take it slow", "천천히 하다"]] },
      { "id": "co2", "en": "Are you tired? We can rest a bit.", "ko": "피곤해? 조금 쉬어도 돼.", "words": [["rest a bit", "조금 쉬다"]] },
      { "id": "co3", "en": "This is the best meal of the trip.", "ko": "이번 여행에서 제일 맛있는 밥이야.", "words": [["meal", "식사"]] },
      { "id": "co4", "en": "I'm glad we came here.", "ko": "여기 오길 잘했어.", "words": [["glad", "기쁜"]] },
      { "id": "co5", "en": "Shall we split the dessert?", "ko": "디저트 나눠 먹을까?", "words": [["split", "나누다"]] },
      { "id": "co6", "en": "Let's get up early for the sunrise.", "ko": "해돋이 보러 일찍 일어나자.", "words": [["sunrise", "해돋이"]] },
      { "id": "co7", "en": "You pick the place for dinner.", "ko": "저녁 먹을 데는 네가 골라.", "words": [["pick", "고르다"]] },
      { "id": "co8", "en": "We should write this down before we forget.", "ko": "잊기 전에 적어 두자.", "words": [["write down", "적어 두다"]] },
      { "id": "co9", "en": "Let's add this to our list for next time.", "ko": "다음에 올 때 목록에 이거 넣어 두자.", "words": [["add to", "~에 더하다"]] },
      { "id": "co10", "en": "I'd come back here with you anytime.", "ko": "너랑이라면 언제든 여기 다시 올래.", "words": [["anytime", "언제든"]] }
    ]},
    { "id": "trouble", "label": "불편·문제 말하기", "items": [
      { "id": "tb1", "en": "This isn't what I ordered.", "ko": "이건 제가 주문한 게 아니에요.", "words": [["order", "주문하다"]] },
      { "id": "tb2", "en": "I think there's a mistake on the bill.", "ko": "계산서에 잘못된 게 있는 것 같아요.", "words": [["mistake", "실수"], ["bill", "계산서"]] },
      { "id": "tb3", "en": "The room hasn't been cleaned.", "ko": "방 청소가 안 돼 있어요.", "words": [["clean", "청소하다"]] },
      { "id": "tb4", "en": "Could we move to another table?", "ko": "다른 자리로 옮겨도 될까요?", "words": [["move to", "~로 옮기다"]] },
      { "id": "tb5", "en": "It's been thirty minutes since we ordered.", "ko": "주문한 지 30분이 지났어요.", "words": [["since", "~이후로"]] },
      { "id": "tb6", "en": "The shower has no hot water.", "ko": "샤워기에서 뜨거운 물이 안 나와요.", "words": [["hot water", "온수"]] },
      { "id": "tb7", "en": "I'd like to speak to the manager.", "ko": "매니저와 이야기하고 싶어요.", "words": [["manager", "매니저"]] },
      { "id": "tb8", "en": "We were charged twice.", "ko": "저희가 두 번 결제됐어요.", "words": [["charge", "청구하다"]] },
      { "id": "tb9", "en": "Could you fix this, please?", "ko": "이거 고쳐 주시겠어요?", "words": [["fix", "고치다"]] },
      { "id": "tb10", "en": "No worries, it happens.", "ko": "괜찮아요, 그럴 수 있죠.", "words": [["it happens", "그럴 수 있다"]] }
    ]}
  ]
}
