{
  "name": "borapin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "VITE_EMULATOR=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-borapin \"playwright test\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-borapin",
    "test:migrate": "firebase emulators:exec --only firestore --project demo-borapin \"GCLOUD_PROJECT=demo-borapin tsx scripts/migrate.ts tests/fixtures/v22-backup.json && GCLOUD_PROJECT=demo-borapin EXPECT_TRIPS=2 tsx scripts/migrate.ts tests/fixtures/v22-backup.json\"",
    "data:travelinfo": "tsx scripts/travelinfo.ts"
  },
  "dependencies": {
    "es-hangul": "^2.4.0",
    "exifr": "^7.1.3",
    "firebase": "^13.0.0",
    "maplibre-gl": "^6.14.0",
    "photoswipe": "^5.4.4",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "topojson-client": "^3.1.0",
    "write-excel-file": "^2.3.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.34.0",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0"
  }
}
